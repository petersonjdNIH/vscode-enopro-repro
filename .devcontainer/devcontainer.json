{
  // Minimal reproducer for:
  // ENOPRO: No file system provider found for resource 'file:///workspaces/<name>'
  //
  // Root cause: VS Code shell integration (terminal.integrated.shellIntegration.enabled,
  // which defaults to TRUE) injects activation scripts whose URIs are anchored to the
  // file:// VFS provider. In VS Code Web (Codespaces), after the first Copilot Agent
  // run_in_terminal call completes and its terminal session is closed/recycled, the
  // shell integration teardown drops the VFS provider registration for the workspace
  // root. The next run_in_terminal call cannot resolve file:// URIs → ENOPRO.
  //
  // Fix: set terminal.integrated.shellIntegration.enabled to FALSE (see README).
  // The setting is intentionally omitted here so the bug reproduces.
  "name": "vscode-enopro-repro",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",

  "customizations": {
    "vscode": {
      "extensions": [
        // Only this extension is needed — it provides the run_in_terminal tool.
        "github.copilot-chat"
      ],
      "settings": {
        // *** BUG IS HERE BY OMISSION ***
        // terminal.integrated.shellIntegration.enabled defaults to true.
        // That default is what triggers the bug.
        //
        // To apply the fix, add:
        //   "terminal.integrated.shellIntegration.enabled": false
      }
    }
  },

  // webOnly ensures the Codespace always opens in VS Code Web (the browser),
  // where the file:// VFS provider lives in the renderer process and is vulnerable
  // to the shell-integration teardown. The bug does not reproduce in VS Code Desktop.
  "hostRequirements": {
    "webOnly": true
  },

  "remoteUser": "vscode"
}
